{
  "name": "@dsh-better/session-drawer",
  "version": "0.1.0",
  "type": "module",
  "description": "Session Drawer — slide-out panel for multi-session/workspace switching in DSH",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "clsx": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsdown": "workspace:^"
  }
}
