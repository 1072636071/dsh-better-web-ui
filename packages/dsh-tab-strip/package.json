{
  "name": "@dsh-better/session-drawer",
  "version": "0.1.0",
  "type": "module",
  "description": "Session Drawer — slide-out panel for multi-session/workspace switching in DSH",
  "main": "lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "vite build && vite build --mode client",
    "build:host": "vite build",
    "build:client": "vite build --mode client",
    "typecheck": "tsc --noEmit",
    "watch": "vite build --watch --mode client",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "clsx": "^2.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.1",
    "clsx": "^2.1.1",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
